<Window x:Class="KeySender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeySender" Height="680" Width="920" MinHeight="520" MinWidth="700"
        Background="#F3F5F8" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing" Loaded="Window_Loaded">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D6DCE5"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#CBD2DD"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="White">
      <MenuItem Header="Файл">
        <MenuItem Header="Открыть…" Click="Open_Click"/><MenuItem Header="Сохранить как…" Click="SaveAs_Click"/><Separator/>
        <MenuItem Header="Последние сценарии" x:Name="RecentMenu"/><Separator/>
        <MenuItem Header="Выход" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="Справка" Click="Help_Click"/>
    </Menu>
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DDE2EA" BorderThickness="0,1,0,0" Padding="14,10">
      <DockPanel><TextBlock x:Name="EmergencyHotkeyText" Text="F8 — аварийная остановка" Foreground="#687386" DockPanel.Dock="Right"/>
        <TextBlock x:Name="StatusText" Text="Готов" FontWeight="SemiBold" Foreground="#263247"/></DockPanel>
    </Border>
    <Grid Margin="20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="KeySender" FontSize="24" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,18"/>
      <Grid Grid.Row="1" Margin="0,0,0,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Задержка перед стартом:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="StartDelayBox" Width="58" Text="5" VerticalContentAlignment="Center"/>
          <TextBlock Text="сек" VerticalAlignment="Center" Margin="6,0,18,0"/>
          <TextBlock Text="Интервал между клавишами:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="KeyDelayBox" Width="58" Text="50" VerticalContentAlignment="Center"/>
          <TextBlock Text="мс" VerticalAlignment="Center" Margin="6,0,18,0"/>
          <TextBlock Text="Задержка после Enter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="EnterDelayBox" Width="58" Text="100" VerticalContentAlignment="Center"/>
          <TextBlock Text="мс" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center">
          <CheckBox x:Name="MinimizeCheck" Content="Сворачивать после Play" IsChecked="True" VerticalAlignment="Center" Margin="0,0,18,0"/>
          <CheckBox x:Name="RandomDelayCheck" Content="Случайная задержка" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="от" VerticalAlignment="Center"/>
          <TextBox x:Name="RandomMinBox" Width="48" Text="40" VerticalContentAlignment="Center" Margin="5,0,5,0"/>
          <TextBlock Text="до" VerticalAlignment="Center"/>
          <TextBox x:Name="RandomMaxBox" Width="48" Text="70" VerticalContentAlignment="Center" Margin="5,0,5,0"/>
          <TextBlock Text="мс" VerticalAlignment="Center" Margin="0,0,18,0"/>
          <TextBlock Text="Повторить:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="RepeatCountBox" Width="56" Text="1" VerticalContentAlignment="Center"/>
          <TextBlock Text="раз" VerticalAlignment="Center" Margin="6,0,18,0"/>
        </WrapPanel>
      </Grid>
      <Grid Grid.Row="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
          <TextBlock Text="Сценарий" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Content="Enter" Tag="{}{ENTER}" Click="InsertCommand_Click"/><Button Content="Tab" Tag="{}{TAB}" Click="InsertCommand_Click"/>
            <Button Content="Esc" Tag="{}{ESC}" Click="InsertCommand_Click"/><Button Content="Wait" Tag="{}{WAIT 1000}" Click="InsertCommand_Click"/>
            <Button Content="Ctrl+C" Tag="{}{CTRL+C}" Click="InsertCommand_Click"/><Button Content="Ctrl+V" Tag="{}{CTRL+V}" Click="InsertCommand_Click"/>
            <Button Content="Ctrl+X" Tag="{}{CTRL+X}" Click="InsertCommand_Click"/><Button Content="Ctrl+A" Tag="{}{CTRL+A}" Click="InsertCommand_Click"/>
            <Button Content="Ctrl+S" Tag="{}{CTRL+S}" Click="InsertCommand_Click"/>
            <Button Content="Alt+F4" Tag="{}{ALT+F4}" Click="InsertCommand_Click"/><Button Content="Win+R" Tag="{}{WIN+R}" Click="InsertCommand_Click"/>
          </StackPanel>
        </DockPanel>
        <TextBox x:Name="ScriptBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="White" BorderBrush="#CBD2DD" BorderThickness="1" Padding="12"
                 SpellCheck.IsEnabled="False" AutomationProperties.Name="Редактор сценария"/>
      </Grid>
      <DockPanel Grid.Row="3" Margin="0,14,0,0">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <TextBlock Text="Режим:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="InputModeBox" Width="150" SelectedIndex="0" VerticalContentAlignment="Center">
            <ComboBoxItem Content="Keyboard"/><ComboBoxItem Content="Clipboard"/>
          </ComboBox>
          <CheckBox x:Name="NewLineCheck" Content="Перенос строки = Enter" Margin="18,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button x:Name="PlayButton" Content="▶  PLAY" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" FontWeight="Bold" Click="Play_Click"/>
          <Button x:Name="StopButton" Content="■  STOP" Click="Stop_Click" IsEnabled="False"/>
          <Button Content="Открыть" Click="Open_Click"/><Button Content="Сохранить" Click="Save_Click"/>
        </StackPanel>
      </DockPanel>
      <TextBlock Grid.Row="4" Text="Укажите сценарий, нажмите PLAY и переключитесь в нужное окно. Обычные переносы строк не нажимают Enter." Foreground="#687386" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </Grid>
  </DockPanel>
</Window>
